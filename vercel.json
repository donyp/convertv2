{
  "installCommand": "npm install",
  "buildCommand": "next build",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/v1/convert",
      "destination": "/api/convert"
    }
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,.next/**,node_modules/**}"
    }
  }
}
